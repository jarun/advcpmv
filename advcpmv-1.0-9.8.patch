+/* Progress state for the file currently being copied.  Set up in
+   copy_file_data (which has the cp_options and source size) and read by
+   sparse_copy/lseek_copy while they run.  Only touched when the global
+   progress flag is set.  */
+static struct progress_status g_s_progress;
+
+FILE * spawn( const char *cmd, char *const argv[] )
+{
+    FILE *ret = NULL;
+    int pfd_read[2];
+    pid_t pid;
+
+    if (cmd == NULL || argv == NULL)
+        return ret;
+
+    if (pipe(pfd_read) < 0) {
+        error(0, errno, "pipe: %s", cmd);
+        return ret;
+    }
+
+    if ((pid = fork()) == 0) {
+        int err = dup2(pfd_read[1], 1) < 0;
+        close(pfd_read[0]);
+        close(pfd_read[1]);
+
+        if (err)
+            error(EXIT_FAILURE, errno, "dup2: %s", cmd);
+        execvp(cmd, argv);
+        error(EXIT_FAILURE, errno, "exec: %s", cmd);
+    }
+
+    close(pfd_read[1]);
+
+    if (pid < 0) {
+        close(pfd_read[0]);
+        error(0, errno, "fork: %s", cmd);
+        return ret;
+    }
+
+    ret = fdopen(pfd_read[0], "r");
+    return ret;
+}
+
+/* Close a stream returned by spawn and reap the child process.  */
+static void spawn_close ( FILE *fp )
+{
+    fclose ( fp );
+    wait ( NULL );
+}
+
+/* Return how many regular files copying PATH will write: 1 for a
+   non-directory operand, or the number of regular files below a directory.
+   Only regular files are counted because only they go through
+   copy_file_data, which is where g_iFilesCopied is incremented.  */
+int progress_count_files ( char const *path )
+{
+    struct stat st;
+    if ( stat ( path, &st ) != 0 || ! S_ISDIR ( st.st_mode ) )
+        return 1;
+
+    FILE *fp = spawn ( "find", (char *[]){ "find", (char *) path, "-type", "f", NULL } );
+    if ( fp == NULL )
+        return 0;
+
+    int count = 0;
+    char *line = NULL;
+    size_t line_size = 0;
+    while ( getline ( &line, &line_size, fp ) > 0 )
+        count++;
+    free ( line );
+    spawn_close ( fp );
+    return count;
+}
+
+/* Return the disk usage of PATH in KiB as reported by "du -s", or 0.  */
+long progress_disk_usage ( char const *path )
+{
+    FILE *fp = spawn ( "du", (char *[]){ "du", "-s", (char *) path, NULL } );
+    if ( fp == NULL )
+        return 0;
+
+    char output[1024];
+    long size = 0;
+    if ( fgets ( output, sizeof output, fp ) != NULL )
+        size = atol ( output );  /* stops at the tab before the file name */
+    spawn_close ( fp );
+    return size;
+}
+
+void format_time ( char * _cDest, double seconds, bool showall )
+{
+  /* hours */
+  int hr = ( (int) seconds / (60 * 60)) % 24;
+  /* minutes */
+  int min = ( (int) seconds / 60) % 60;
+  /* seconds */
+  double sec = seconds - (hr * (60 * 60)) - (min * 60);
+  if ( showall )
+  {
+    if ( seconds < 0 )
+      sprintf(_cDest, "%2ch %2cm %2cs", '0', '0', '?');
+    else
+      sprintf(_cDest, "%2dh %2dm %2ds", hr, min, (int) sec);
+  } else  if ( seconds >= 3600 )
+  {
+    sprintf(_cDest, "%2dh %2dm %4.1fs", hr, min, sec);
+  } else if ( seconds >= 60 )
+  {
+    sprintf(_cDest, "%2dm %4.1fs", min, sec);
+  } else
+  {
+    sprintf(_cDest, "%4.1fs", sec);
+  }
+}
+
+static void file_progress_bar ( char * _cDest, int _iBarLength, long _lProgress, long _lTotal )
+{
+    double dPercent = (double) _lProgress / (double) _lTotal * 100.f;
+    sprintf( _cDest + ( _iBarLength - 6), "%4.1f", dPercent );
+    _cDest[_iBarLength - 2] = ' ';
+
+    int i;
+    for ( i=1; i<=_iBarLength - 9; i++)
+    {
+        if ( dPercent > (double) (i-1) / (_iBarLength - 10) * 100.f )
+        {
+            _cDest[i] = '=';
+        }
+        else
+        {
+            _cDest[i] = ' ';
+        }
+    }
+    for ( i=1; i<_iBarLength - 9; i++)
+    {
+        if ( ( _cDest[i+1] == ' ' ) && ( _cDest[i] == '=' ) )
+            _cDest[i] = '>' ;
+    }
+}
+
+int file_size_format ( char * _cDst, long _lSize, int _iCounter )
+{
+  int iCounter = _iCounter;
+  double dSize = ( double ) _lSize;
+  while ( dSize >= 1000. )
+  {
+    dSize /= 1024.;
+    iCounter++;
+  }
+
+  /* get unit */
+  char * sUnit;
+  if ( iCounter == 0 )
+    sUnit = "B";
+  else if ( iCounter == 1 )
+    sUnit = "KiB";
+  else if ( iCounter == 2 )
+    sUnit = "MiB";
+  else if ( iCounter == 3 )
+    sUnit = "GiB";
+  else if ( iCounter == 4 )
+    sUnit = "TiB";
+  else
+    sUnit = "N/A";
+
+  /* write number */
+  return sprintf ( _cDst, "%5.1f %s", dSize, sUnit );
+}
+/* END progress mod */
